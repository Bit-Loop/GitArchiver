# ========================================
# GitArchiver Environment Configuration
# ========================================

# ----- Database Configuration -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=github_archiver
DB_USER=github_archiver
DB_PASSWORD=github_archiver_password

# Database Pool Settings (Optional)
DB_MIN_CONNECTIONS=5
DB_MAX_CONNECTIONS=20
DB_COMMAND_TIMEOUT=60

# ----- GitHub API Configuration -----
# Required for scraping GitHub Archive data
# Generate token at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_REDACTED_EXAMPLE
GITHUB_USERNAME=your_github_username

# Optional: GitHub API rate limits
GITHUB_AUTHENTICATED_RATE_LIMIT=5000
GITHUB_UNAUTHENTICATED_RATE_LIMIT=60

# ----- API Server Configuration -----
API_HOST=0.0.0.0
API_PORT=8081

# ----- Security Configuration -----
# JWT Secret for authentication (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_random_32_byte_hex_string

# Admin account (CHANGE ON FIRST LOGIN!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_on_first_login

# Session timeout (minutes)
SESSION_TIMEOUT_MINUTES=60

# ----- Resource Limits -----
# Memory limit (GB) — set to "auto" to use 90% of host RAM
MEMORY_LIMIT_GB=auto

# Disk limit (GB) — set to "auto" to use 85% of host disk
DISK_LIMIT_GB=auto

# CPU limit (percent)
CPU_LIMIT_PERCENT=80.0

# ----- Scraper Configuration -----
# Maximum concurrent downloads
MAX_CONCURRENT_DOWNLOADS=6

# Retry attempts for failed downloads
RETRY_ATTEMPTS=3

# Batch size for database inserts
BATCH_SIZE=1000

# Start scraper automatically on boot
START_SCRAPER_ON_BOOT=false

# ----- Optional: Redis Cache -----
# Uncomment to enable Redis caching
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ----- Optional: Monitoring -----
# Enable Prometheus metrics
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Enable Grafana dashboards
GRAFANA_ENABLED=false
GRAFANA_PORT=3000

# ----- Logging Configuration -----
# Log level: trace, debug, info, warn, error
RUST_LOG=info

# Log format: json, pretty, compact
LOG_FORMAT=pretty

# Log to file
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log

# ----- Development/Testing -----
# Set to 'development' or 'production'
ENVIRONMENT=production

# Enable debug mode
DEBUG=false

# ----- Optional: External Services -----
# Webhook URL for notifications
# WEBHOOK_URL=https://your-webhook-endpoint.com

# Slack webhook for alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ----- Optional: Advanced Features -----
# Enable multi-source data integration
ENABLE_MULTI_SOURCE=false

# Enable secret scanning
ENABLE_SECRET_SCANNER=true

# Enable AI triage
ENABLE_AI_TRIAGE=false
AI_TRIAGE_BASE_URL=http://127.0.0.1:11434/v1
AI_TRIAGE_MODEL=
# AI_TRIAGE_API_KEY=

# Enable tree visualization
ENABLE_TREE_VISUALIZATION=false

# ========================================
# Quick Setup Instructions
# ========================================
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Generate JWT secret:
#    openssl rand -hex 32
#
# 3. Set GitHub token:
#    https://github.com/settings/tokens
#
# 4. Update admin password
#
# 5. Adjust resource limits for your system
#
# 6. Start database:
#    docker-compose up -d postgres
#
# 7. Run the application:
#    cargo run --bin web_server
#
# ========================================
