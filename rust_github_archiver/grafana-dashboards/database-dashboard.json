{
  "dashboard": {
    "title": "GitHub Archiver - Database Performance",
    "tags": ["github-archiver", "database", "postgresql"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Query Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "rate(pg_stat_database_xact_commit[5m])",
            "legendFormat": "Commits"
          },
          {
            "expr": "rate(pg_stat_database_xact_rollback[5m])",
            "legendFormat": "Rollbacks"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Transactions/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Connection Count",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "pg_stat_database_numbackends",
            "legendFormat": "{{datname}}"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Connections"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "Cache Hit Ratio",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "pg_stat_database_blks_hit / (pg_stat_database_blks_hit + pg_stat_database_blks_read)",
            "legendFormat": "{{datname}}"
          }
        ],
        "yaxes": [
          {"format": "percentunit", "label": "Cache Hit Ratio"},
          {"format": "short"}
        ]
      },
      {
        "id": 4,
        "title": "Tuple Operations",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "rate(pg_stat_database_tup_inserted[5m])",
            "legendFormat": "Inserted"
          },
          {
            "expr": "rate(pg_stat_database_tup_updated[5m])",
            "legendFormat": "Updated"
          },
          {
            "expr": "rate(pg_stat_database_tup_deleted[5m])",
            "legendFormat": "Deleted"
          },
          {
            "expr": "rate(pg_stat_database_tup_fetched[5m])",
            "legendFormat": "Fetched"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Operations/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "title": "Table Size",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "pg_table_size_bytes",
            "legendFormat": "{{table}}"
          }
        ],
        "yaxes": [
          {"format": "bytes", "label": "Size"},
          {"format": "short"}
        ]
      },
      {
        "id": 6,
        "title": "Index Size",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "expr": "pg_index_size_bytes",
            "legendFormat": "{{index}}"
          }
        ],
        "yaxes": [
          {"format": "bytes", "label": "Size"},
          {"format": "short"}
        ]
      },
      {
        "id": 7,
        "title": "Deadlocks",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "rate(pg_stat_database_deadlocks[5m])",
            "legendFormat": "{{datname}}"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Deadlocks/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 8,
        "title": "Locks",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "targets": [
          {
            "expr": "pg_locks_count",
            "legendFormat": "{{mode}}"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Lock Count"},
          {"format": "short"}
        ]
      },
      {
        "id": 9,
        "title": "Slow Queries",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "pg_stat_activity_max_tx_duration",
            "legendFormat": "Max Duration"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Duration"},
          {"format": "short"}
        ]
      },
      {
        "id": 10,
        "title": "Database Size",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
        "targets": [
          {
            "expr": "pg_database_size_bytes",
            "legendFormat": "{{datname}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 85899345920, "color": "yellow"},
                {"value": 107374182400, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 11,
        "title": "Replication Lag",
        "type": "stat",
        "gridPos": {"h": 4, "w": 12, "x": 0, "y": 40},
        "targets": [
          {
            "expr": "pg_replication_lag",
            "legendFormat": "Lag"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 5, "color": "yellow"},
                {"value": 10, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 12,
        "title": "Checkpoint Stats",
        "type": "graph",
        "gridPos": {"h": 4, "w": 12, "x": 12, "y": 40},
        "targets": [
          {
            "expr": "rate(pg_stat_bgwriter_checkpoints_timed[5m])",
            "legendFormat": "Timed"
          },
          {
            "expr": "rate(pg_stat_bgwriter_checkpoints_req[5m])",
            "legendFormat": "Requested"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Checkpoints/sec"},
          {"format": "short"}
        ]
      }
    ]
  }
}
